[Unit]
Description=Newspaper collect, verify, build and notify
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=6h
StartLimitBurst=3

[Service]
Type=oneshot
Restart=on-failure
RestartSec=5min
User=newspaper
Group=newspaper
WorkingDirectory=/opt/Newspaper
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=NEWSPAPER_CONFIG=/etc/newspaper/config.toml
EnvironmentFile=/etc/newspaper/credentials.env
ExecStart=/opt/Newspaper/.venv/bin/python -m newspaper.cli run
TimeoutStartSec=50min
KillMode=control-group
SuccessExitStatus=75
MemoryMax=512M
CPUQuota=150%
Nice=10
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/newspaper /srv/newspaper
StandardOutput=null
StandardError=null
