# Copy to /etc/newspaper/credentials.env, chmod 640, owner root:newspaper.
D1API_API_KEY=
# Optional search provider credentials (keyless engines also work):
EXA_API_KEY=
FIRECRAWL_API_KEY=
# SMTP: use an existing authenticated SMTP service, not a new mail server.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional egress proxy; do not commit machine-specific values.
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1,::1
