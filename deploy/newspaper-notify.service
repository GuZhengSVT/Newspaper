[Unit]
Description=Retry Newspaper notifications without regenerating news
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=newspaper
Group=newspaper
WorkingDirectory=/opt/Newspaper
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=NEWSPAPER_CONFIG=/etc/newspaper/config.toml
EnvironmentFile=/etc/newspaper/credentials.env
ExecStart=/opt/Newspaper/.venv/bin/python -m newspaper.cli notify
TimeoutStartSec=10min
SuccessExitStatus=75
MemoryMax=128M
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/newspaper /srv/newspaper
StandardOutput=null
StandardError=null
