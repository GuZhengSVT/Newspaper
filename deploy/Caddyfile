# HTTP IP access. Set a domain instead of :80 to configure HTTPS later.
:80 {
	root * /srv/newspaper/current
	encode gzip
	header {
		Cache-Control "no-store"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
	}
	@markdown path /downloads/*.md
	header @markdown Content-Disposition attachment
	file_server
}
